{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    // No `declarationMap`/`sourceMap`. They are only useful when the
    // sources they reference are present, and the package deliberately
    // ships `dist` alone — emitting maps that point at an absent `src/`
    // is worse than emitting none, because a debugger reports a broken
    // map rather than simply falling back to the built output.
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  // Stories are documentation, not library API: they must not reach
  // `dist` and must not be published. Excluding them also sidesteps a
  // real declaration-emit failure — a story's inferred `meta` type
  // cannot be named through pnpm's virtual store (TS2742), the same
  // class of error the drawer's re-exports hit, and invisible to
  // `tsc --noEmit` because only emit exercises it.
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.tsx",
    ".storybook"
  ]
}
