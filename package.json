{
  "name": "@vaam-apps/ui",
  "version": "0.2.3",
  "description": "A dark-first React component library for operator consoles — daisyUI styling, Headless UI behaviour, and a parameterised status-glyph system.",
  "license": "MIT",
  "author": "Vaam Apps",
  "homepage": "https://github.com/vaam-apps/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaam-apps/ui.git"
  },
  "bugs": {
    "url": "https://github.com/vaam-apps/ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "tailwindcss",
    "daisyui",
    "headlessui",
    "dashboard",
    "admin"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles/theme.css": "./src/styles/theme.css",
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles/theme.css": "./dist/styles/theme.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-styles.mjs && node scripts/specify-extensions.mjs dist",
    "build-storybook": "storybook build -o storybook-static",
    "clean": "rm -rf dist storybook-static",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "biome check --write .",
    "lint": "biome check .",
    "prepack": "npm run build",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "daisyui": "^5",
    "react": "^18.3.0 || ^19",
    "react-dom": "^18.3.0 || ^19",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@radix-ui/react-dialog": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "^1.44.0",
    "react-day-picker": "^10.0.1",
    "tailwind-merge": "^3.6.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@material/material-color-utilities": "0.4.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "daisyui": "^5.7.36",
    "jsdom": "^30.0.1",
    "react": "^19",
    "react-dom": "^19",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "vite": "^8",
    "vitest": "^5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.4.1"
}
